# CommitmentOS configuration.
#
#   cp .env.example .env && ./scripts/init-env.sh      (or just: ./scripts/init-env.sh)
#
# init-env.sh fills every *empty* secret below with a random value. Never commit .env.
# Values must not contain spaces, quotes or '$'. Generated secrets are hex, which is safe.

# ─── Runtime ────────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:3000

# ─── Ports published on 127.0.0.1 ───────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
N8N_PORT=5678
POSTGRES_HOST_PORT=5433
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=commitmentos
POSTGRES_PASSWORD=
POSTGRES_DB=commitmentos

# ─── Auth ───────────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL_MINUTES=720
COOKIE_SECURE=false                 # true when served over HTTPS (required in production)
ALLOW_REGISTRATION=true             # set false once your account exists
CORS_ORIGINS=http://localhost:3000

# ─── n8n <-> API (two independent shared secrets, one per direction) ────────────────
N8N_INBOUND_SECRET=                 # n8n -> API  (sent as X-Webhook-Secret)
N8N_OUTBOUND_SECRET=                # API -> n8n  (n8n webhook "Header Auth")
N8N_ENCRYPTION_KEY=                 # encrypts credentials stored inside n8n
N8N_BASE_URL=http://n8n:5678
# n8n keeps the data of FAILED executions (it contains message text) so they can be inspected and retried, and prunes it after
# N8N_EXECUTIONS_MAX_AGE_HOURS. Successful executions keep nothing by default; set 'all' only while debugging a workflow.
N8N_SAVE_SUCCESS_EXECUTIONS=none    # none | all
N8N_EXECUTIONS_MAX_AGE_HOURS=72

# ─── LLM: extraction/classification only (never deterministic decisions) ───────────
# gemini        -> GEMINI_API_KEY     (Google AI Studio key; native REST)
# openai_compat -> any OpenAI-compatible /v1/chat/completions server (Ollama, vLLM, LM Studio, OpenAI...)
# none          -> extraction disabled; messages are recorded as EXTRACTION_FAILED
# NOTE: free-tier hosted LLM plans may use prompts to improve their models. For real mailboxes use a paid/no-training tier or a local model.
# NOTE: free tiers also cap requests per DAY per model (a few dozen). When spent, extraction reports LLM_QUOTA_EXHAUSTED and does not retry.
LLM_PROVIDER=gemini                 # gemini | openai_compat | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0            # 0 = no hidden reasoning; blank = send no thinkingConfig (a few models reject it)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TRANSIENT_RETRIES=2
LLM_MAX_REPAIR_ATTEMPTS=1

# ─── Detection policy (applied by code after validation) ────────────────────────────
CONFIDENCE_HIGH=0.85                # >= high   -> create OPEN obligation automatically
CONFIDENCE_MEDIUM=0.60              # >= medium -> create NEEDS_REVIEW; below -> detection candidate only

# ─── Reminder policy (deterministic) ────────────────────────────────────────────────
REMINDER_OFFSETS_HOURS=24,6         # reminder N hours before the deadline (last one is "high priority")
ESCALATE_AFTER_HOURS=24             # hours past the deadline before an OVERDUE item is ESCALATED
NOTIFICATION_MAX_ATTEMPTS=3

# ─── Time ───────────────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=UTC                # per-user timezone overrides this
BUSINESS_DAY_END=17:00              # what "EOD"/"COB" means
DEFAULT_DATE_ORDER=MDY              # how 03/04/2026 is read when a user has no preference (MDY|DMY)

# ─── Notifications ──────────────────────────────────────────────────────────────────
NOTIFY_FROM_EMAIL=commitmentos@localhost
# Until an account is configured, every email is caught by Mailpit on this machine (http://localhost:8025) and nothing is delivered;
# the app says so on every page. For real delivery, e.g. Gmail with an app password (Google Account > Security > App passwords):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password, no spaces>
#   NOTIFY_FROM_EMAIL=you@gmail.com        then:  docker compose up -d api && ./scripts/n8n-reload.sh
SMTP_HOST=mailpit                   # Mailpit catches all mail locally: http://localhost:8025
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
TELEGRAM_BOT_TOKEN=                 # optional; leave empty to disable the Telegram channel
TELEGRAM_CHAT_ID=

# ─── Calendar ───────────────────────────────────────────────────────────────────────
CALENDAR_PROVIDER=local             # local (built-in, no credentials) | google (needs Google Calendar OAuth credential in n8n)

# ─── Gmail / Google (configured inside n8n, see automation/n8n/README.md) ───────────
GMAIL_OWNER_EMAIL=                  # CommitmentOS account that the polled mailbox belongs to

# ─── abuse limits (per client, per process) ─────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=600
